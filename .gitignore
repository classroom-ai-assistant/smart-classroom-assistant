# ==========================================
# الأسرار والإعدادات المحلية — لا تُرفع أبداً
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================
# الصوت — يُمنع حفظ أي تسجيل صوتي (BRL-07, DR-08)
# ==========================================
*.wav
*.mp3
*.ogg
*.webm
*.m4a
*.flac
# استثناء: نغمات التنبيه الثابتة للواجهة (FR-062) ليست تسجيلات أطفال
!frontend/public/sounds/**

# ==========================================
# Backend — Python / FastAPI
# ==========================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ==========================================
# Frontend — React / Vite
# ==========================================
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ==========================================
# Supabase — الملفات المحلية المؤقتة فقط
# (ملفات migrations تُرفع؛ هذه لا)
# ==========================================
supabase/.branches/
supabase/.temp/
supabase/.env

# ==========================================
# السجلات وملفات النظام والمحرر
# ==========================================
*.log
logs/
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
