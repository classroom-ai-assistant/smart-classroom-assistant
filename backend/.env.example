# Copy to .env and fill in. Never commit .env.

APP_ENV=development

# Supabase project URL (Project Settings > API). Used to fetch the public
# JWT signing keys and to check the token issuer. Not a secret.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Postgres connection string (Project Settings > Database > Connection string).
# Use the Session pooler (port 5432) or the direct connection.
# If the password has special characters, percent-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Database pool size.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
