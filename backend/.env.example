# Copy to .env and fill in. Never commit .env.

APP_ENV=development

# Supabase project URL (Project Settings > API). Used to fetch the public
# JWT signing keys and to check the token issuer. Not a secret.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Postgres connection string (Project Settings > Database > Connection string).
# Use the Session pooler (port 5432) or the direct connection.
# If the password has special characters, percent-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Database pool size.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# AI content (Gemini). Optional: without a key the AI endpoints return 503.
# Never commit a real key; on Render it is set in the dashboard.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_REQUESTS_PER_HOUR=30
# Robot voice (TTS PoC), same key
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
SPEECH_REQUESTS_PER_HOUR=60

# Free picture search (Pixabay, optional). Never commit a real key.
PIXABAY_API_KEY=

# Listening to answers (internship prototype, team voices only).
# OpenAI speech-to-text; never commit a real key.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
LISTEN_REQUESTS_PER_HOUR=300
ASK_REQUESTS_PER_HOUR=120
# Live voice call with the robot (OpenAI Realtime, same OPENAI_API_KEY).
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
LIVE_SESSIONS_PER_HOUR=20
